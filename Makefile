DOTFILES := $(shell pwd)

# Tools installed by asdf with 'make deps'
ASDF_TOOLS := nodejs php golang glab

# Symlink $(1) to $(2), backing up anything at $(2) that isn't a symlink
link = if [ -e "$(2)" ] && [ ! -L "$(2)" ]; then mv "$(2)" "$(2).$$(date +%Y%m%d%H%M%S).bak" && echo "Backed up $(2)"; fi; ln -sfn "$(1)" "$(2)"

# Remove $(1) if it is a symlink into the dotfiles
unlink = case "$$(readlink "$(1)")" in "$(DOTFILES)"/*) rm -f "$(1)";; esac

# Back up $(1) unless it was generated by the dotfiles
backup = if [ -e "$(1)" ] && ! grep -qF "$(DOTFILES)" "$(1)"; then mv "$(1)" "$(1).$$(date +%Y%m%d%H%M%S).bak" && echo "Backed up $(1)"; fi

# Remove $(1) if it was generated by the dotfiles
ungenerate = if grep -qsF "$(DOTFILES)" "$(1)"; then rm -f "$(1)"; fi

# Fail unless $(1) is a symlink to $(2), reported as $(3)
test-link = if [ "$$(readlink "$(1)")" = "$(2)" ]; then echo "[x] $(3)"; else echo "[ ] $(3) not linked"; exit 1; fi

# Fail unless $(1) was generated by the dotfiles, reported as $(2)
test-generated = if grep -qsF "$(DOTFILES)" "$(1)"; then echo "[x] $(2)"; else echo "[ ] $(2) not found"; exit 1; fi

# Install all the dotfiles
install: welcome install-start submodules bash git gnome ssh vim nano inputrc screenrc config test
	@echo ""
	@echo "Dotfiles installed. Run 'make deps' for optional dependencies."
	@echo ""

# Remove any of the dotfiles from the system
clean: submodules-clean git-clean gnome-clean ssh-clean bash-clean vim-clean nano-clean asdf-clean inputrc-clean screenrc-clean config-clean deps-clean

# Test to make sure the dotfiles were set up correctly, running every check even if one fails
test:
	@$(MAKE) --no-print-directory -k submodules-test asdf-test ssh-test git-test gnome-test bash-test vim-test nano-test inputrc-test screenrc-test config-test deps-test

welcome:
	@echo "Welcome to RobLoach/dotfiles!"
	@echo ""
	@echo "    make install: Install the dotfiles"
	@echo "    make test: Ensure everything was installed correctly"
	@echo "    make clean: Uninstall the dotfiles from the system"
	@echo "    make gogh: Installs the terminal color scheme"
	@echo "    make deps: Install tool dependencies with asdf"
	@echo ""

install-start:
	@echo "Installing dotfiles..."

# Display the current status of the dotfiles
status:
	-${MAKE} test
	git status

# Push all changes up to the git repository: make push m="Commit message"
push:
	@test -n "$(m)" || { echo 'Usage: make push m="Commit message"'; exit 1; }
	@git add -A
	@git commit -m "$(m)"
	@git push git@github.com:RobLoach/dotfiles.git master

pull:
	@git pull
	@git status

restart:
	@exec bash

submodules:
	@git submodule update --init --recursive

submodules-clean:
	@git submodule deinit -f .

submodules-test:
	@test -f dependencies/asdf/bin/asdf && echo "[x] Submodules" || { echo "[ ] Submodules not found"; exit 1; }

update:
	@echo "Updating Dependencies"
	@git pull origin master
	@git submodule update --init --remote --recursive
	@git status

asdf: bash submodules
	-@for tool in $(ASDF_TOOLS); do asdf plugin add $$tool; done

# Optional, so this reports without failing the tests
asdf-test:
	@asdf version >/dev/null 2>&1 && echo "[x] asdf installed correctly" || echo "[ ] asdf not found"

asdf-clean:
	@rm -rf ${HOME}/.tool-versions

# Install the latest version of each tool, then the Node.js and Composer packages
deps: asdf
	@echo "Installing Dependencies"
	@for tool in $(ASDF_TOOLS); do asdf install $$tool latest && asdf global $$tool latest || exit 1; done
	@npm install
	@composer install

# Optional, so these report without failing the tests
deps-test:
	@test ! -f $(DOTFILES)/node_modules/.bin/tldr && echo "[ ] Node.js dependencies - Run 'make deps'" || echo "[x] Node.js dependencies"
	@test ! -f $(DOTFILES)/vendor/bin/terminus && echo "[ ] Composer dependencies - Run 'make deps'" || echo "[x] Composer dependencies"

deps-clean:
	@rm -rf $(DOTFILES)/node_modules package-lock.json
	@rm -rf $(DOTFILES)/vendor composer.lock

# ssh
ssh:
	@mkdir -p ${HOME}/.ssh
	@$(call link,$(DOTFILES)/.sshconfig,${HOME}/.ssh/config)

ssh-clean:
	@$(call unlink,${HOME}/.ssh/config)

ssh-test:
	@$(call test-link,${HOME}/.ssh/config,$(DOTFILES)/.sshconfig,SSH config)

# git
git:
	@$(call link,$(DOTFILES)/.gitconfig,${HOME}/.gitconfig)

git-clean:
	@$(call unlink,${HOME}/.gitconfig)

git-test:
	@$(call test-link,${HOME}/.gitconfig,$(DOTFILES)/.gitconfig,Git config)

gnome:
	@$(call link,$(DOTFILES)/.face,${HOME}/.face)

gnome-clean:
	@$(call unlink,${HOME}/.face)

gnome-test:
	@$(call test-link,${HOME}/.face,$(DOTFILES)/.face,Gnome face)

# bash
bash:
	@$(call link,$(DOTFILES)/.bashrc,${HOME}/.bashrc)
	@$(call link,$(DOTFILES)/.bash_profile,${HOME}/.bash_profile)

bash-clean:
	@$(call unlink,${HOME}/.bashrc)
	@$(call unlink,${HOME}/.bash_profile)

bash-test:
	@$(call test-link,${HOME}/.bashrc,$(DOTFILES)/.bashrc,Bash config)
	@$(call test-link,${HOME}/.bash_profile,$(DOTFILES)/.bash_profile,Bash profile)

vim: submodules
	@$(call backup,${HOME}/.vimrc)
	@echo "set runtimepath+=${DOTFILES}/dependencies/vimrc" > "${HOME}/.vimrc"
	@echo "source ${DOTFILES}/dependencies/vimrc/vimrcs/basic.vim" >> "${HOME}/.vimrc"
	@echo "source ${DOTFILES}/dependencies/vimrc/vimrcs/filetypes.vim" >> "${HOME}/.vimrc"
	@echo "source ${DOTFILES}/dependencies/vimrc/vimrcs/plugins_config.vim" >> "${HOME}/.vimrc"
	@echo "source ${DOTFILES}/dependencies/vimrc/vimrcs/extended.vim" >> "${HOME}/.vimrc"
	@echo "source ${DOTFILES}/.vimrc-extras.vim" >> "${HOME}/.vimrc"
	@echo "source ${DOTFILES}/dependencies/tinted-vim/colors/base24-dracula.vim" >> "${HOME}/.vimrc"

vim-clean:
	@$(call ungenerate,${HOME}/.vimrc)

vim-test:
	@$(call test-generated,${HOME}/.vimrc,Vim config)

nano: submodules
	@$(call backup,${HOME}/.nanorc)
	@cat ${DOTFILES}/.nanorc > ${HOME}/.nanorc
	@echo "include \"${DOTFILES}/dependencies/nano-syntax-highlighting/*.nanorc\"" >> ${HOME}/.nanorc

nano-clean:
	@$(call ungenerate,${HOME}/.nanorc)

nano-test:
	@$(call test-generated,${HOME}/.nanorc,nanorc)

# Console colors for gnome-terminal: https://github.com/Gogh-Co/Gogh
gogh:
	GOGH_APPLY_SCRIPT=$(DOTFILES)/dependencies/gogh/apply-colors.sh \
	GOGH_ALACRITTY_SCRIPT=$(DOTFILES)/dependencies/gogh/apply-alacritty.py \
	GOGH_TERMINATOR_SCRIPT=$(DOTFILES)/dependencies/gogh/apply-terminator.py \
	TERMINAL=gnome-terminal \
	bash $(DOTFILES)/dependencies/gogh/installs/dracula.sh

inputrc:
	@$(call link,$(DOTFILES)/.inputrc,${HOME}/.inputrc)

inputrc-clean:
	@$(call unlink,${HOME}/.inputrc)

inputrc-test:
	@$(call test-link,${HOME}/.inputrc,$(DOTFILES)/.inputrc,inputrc)

screenrc:
	@$(call link,$(DOTFILES)/.screenrc,${HOME}/.screenrc)

screenrc-clean:
	@$(call unlink,${HOME}/.screenrc)

screenrc-test:
	@$(call test-link,${HOME}/.screenrc,$(DOTFILES)/.screenrc,screenrc)

# ~/.config — symlink each folder in dot_config into ${HOME}/.config
config:
	@mkdir -p ${HOME}/.config
	@for dir in $(DOTFILES)/dot_config/*/; do \
		name=$$(basename "$$dir"); \
		$(call link,$(DOTFILES)/dot_config/$$name,${HOME}/.config/$$name); \
	done

config-clean:
	@for dir in $(DOTFILES)/dot_config/*/; do \
		name=$$(basename "$$dir"); \
		$(call unlink,${HOME}/.config/$$name); \
	done

config-test:
	@for dir in $(DOTFILES)/dot_config/*/; do \
		name=$$(basename "$$dir"); \
		$(call test-link,${HOME}/.config/$$name,$(DOTFILES)/dot_config/$$name,config/$$name); \
	done
